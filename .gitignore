# Dev and test state (--state-dir), the pinned Chrome for Testing, test folders
/.dev/

# This checkout's local Plow (.env.local.example)
.env.local

# Cargo build output, and the phone page's build (latch/phone/build.sh)
target/
/latch/phone/dist/
/latch/phone/e2e/node_modules/

# The Messages reader's and the Mac app window's Swift build output
/latch/messages-reader/.build/
/latch/messages-reader/dist/
/latch/gui/.build/
# SwiftPM run from latch/ (a tool or editor) leaves one here too
/latch/.build/
/latch/gui/dist/

# Local agent tooling
.claude/
.kitchen/
.superpowers/
docs/superpowers/

# Byte-compiled Python (latch/scripts)
__pycache__/
*.py[codz]

# macOS
.DS_Store

# Release staging output
/dist/
