{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plow Latch",
  "version": "0.1.0",
  "identifier": "co.plow.latch.windows",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Plow Latch",
        "width": 600,
        "height": 660,
        "minWidth": 520,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": []
  }
}
