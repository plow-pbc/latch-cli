# The CLI's own recipes; the root justfile's (`just test`, `just test-list`,
# `just test-plan`) run from here too.
set fallback := true

# The repo's .env.local (see .env.local.example) says which local Plow stack
# the dev recipes use; scripts/dev_plow.py reads it. Its published ports, not
# *.orb.local: macOS keeps an unapproved latch off OrbStack's network ("No
# route to host"), and loopback needs no approval.
set dotenv-filename := ".env.local"

# The Messages reader, built and signed into messages-reader/dist/; prints its sha256.
messages-reader:
    messages-reader/build.sh

# The real-engine browser tests again, headed: each session a real window,
# behind the owner's. Their focus checks (the engine never becomes the
# front app) mean something only here. Not part of the gate: windows appear.
[macos]
test-headed: engines
    cargo test --locked --features headed-tests browser::tests

# The pinned engines, Chrome for Testing and Camoufox, where the browser
# tests look for them (`just test browser` installs them itself). HOME keeps
# install-binary.sh's copy of latch out of the real ~/.local/bin.
[macos]
engines:
    cargo build --locked
    HOME="$PWD/../.dev/cft-home" sh install-binary.sh --non-interactive --state-dir ../.dev/cft-state --browser chrome --browser camoufox "${CARGO_TARGET_DIR:-target}/debug/latch"

# The return scenario, headless, with its transcript: an order found in a
# made-up mailbox, returned item by item on the test shop, its judge a
# stand-in (`just gatekeeper scenario` runs it on the real one).
[macos]
scenario-return: engines
    cargo test --locked --features fake-gog --test cli scenario::the_owner_returns_items_from_an_emailed_order -- --exact --nocapture

# Logs this checkout's ../.dev/state in to the local Plow stack, by text to
# its Linq twin from a made-up phone (the same local account each time).
dev-login api="" twin="":
    cargo build --quiet --locked
    python3 scripts/dev-login.py "${CARGO_TARGET_DIR:-target}/debug/latch" "$(cd .. && pwd)/.dev/state" --api "{{api}}" --twin "{{twin}}"

# Asks the real decision model as a host does, through Plow on the login of
# this checkout's ../.dev/state (`just dev-login` first), synthetic chats only: `checks` (the gatekeeper's and the
# browser's), `replay OUT` (the held-out corpus, twice per probe, its
# decisions written to OUT) or `scenario` (the return on the test shop).
gatekeeper what="checks" out="":
    #!/bin/sh
    set -eu
    state="$(cd .. && pwd)/.dev/state"
    if ! cargo run --quiet --locked -- --state-dir "$state" status >/dev/null; then
        echo "just gatekeeper asks Plow on the login of $state: run \`just dev-login\` first" >&2
        exit 2
    fi
    export LATCH_GATEKEEPER_STATE="$state"
    case "{{what}}" in
    checks)
        cargo test --locked --features live-model -- gate::tests::live_owner serve::gated_tests::live browser::tests::steps::live --nocapture ;;
    replay)
        [ -n "{{out}}" ] || { echo "usage: just gatekeeper replay OUT" >&2; exit 2; }
        LATCH_TEST_REPLAY_OUT="{{out}}" cargo test --locked --features live-model gate::tests::live_held_out_replay -- --nocapture ;;
    scenario)
        just engines
        cargo test --locked --features fake-gog,live-model --test cli scenario::the_owner_returns_items_from_an_emailed_order_through_the_real_judge -- --exact --nocapture ;;
    *)
        echo "usage: just gatekeeper [checks | replay OUT | scenario]" >&2
        exit 2 ;;
    esac

# The plan suite (tests/browser-shop) on the decision model, through the dev
# Plow stack the host in `host_state` is logged in to; each run, with its
# metrics (scripts/plan-metrics.py), is kept under `out`; the profile is on
# `engine` (cft or camoufox).
plan-suite host_state out engine="cft":
    status=0; LATCH_SUITE_ENGINE="{{engine}}" LATCH_SUITE_HOST_STATE="{{host_state}}" LATCH_SUITE_OUT="{{out}}" cargo test --locked --bin latch the_plan_suite_on_the_decision_model -- --ignored --nocapture || status=$?; run="$(ls -d "{{out}}"/2*/ | sort | tail -1)"; python3 scripts/plan-metrics.py "$run/audit.ndjson" > "$run/metrics.json"; exit $status

# A shopping task with every agent command through the gatekeeper, on jev
# through the dev Plow stack the host in `host_state` is logged in to, with a
# synthetic chat: its judge calls, cost and added time, kept under `out`.
gated-shopping host_state out:
    LATCH_GATE_HOST_STATE="{{host_state}}" LATCH_GATE_OUT="{{out}}" cargo test --locked --bin latch a_gated_shopping_task_on_the_decision_model -- --ignored --nocapture

# The phone page (phone/): iroh for the browser plus the shim, into phone/dist.
phone:
    phone/build.sh

# Serves phone/dist on this machine, for `latch vault link --page
# http://localhost:PORT/` (an emulator here, or a phone on the network with
# --bind 0.0.0.0). Never publish it from here.
phone-serve port="8731" bind="127.0.0.1":
    python3 -m http.server {{port}} --bind {{bind}} --directory phone/dist

# The phone link end to end against a running HOST on this machine: saved
# from WebKit as an iPhone, used by a browser login on the host, and looked
# for in the host's and client's files. Needs LATCH, CLIENT_STATE,
# HOST_STATE and HOST_LOG (see phone/e2e/run.sh). Not a gate: it needs the
# live host and its relay.
phone-e2e host: phone
    phone/e2e/run.sh {{host}}

# This checkout, built for release into ../.dev/bin/latch for hand testing.
# Its state folder, ../.dev/state, and Plow (`api`: the local stack unless
# named, e.g. api=https://api.plow.co) are baked in, so it never touches
# ~/.latch or an installed latch; flags still override them. A running serve
# keeps its old binary until it is restarted.
build api="":
    #!/bin/sh
    set -eu
    api="{{api}}"
    [ -n "$api" ] || api="$(python3 scripts/dev_plow.py api)"
    root="$(cd .. && pwd)"
    state="$root/.dev/state"
    # The host's socket lives in the state folder; macOS caps its path at 104 bytes.
    if [ "$(printf '%s' "$state/serve-v3.sock" | wc -c)" -ge 104 ]; then
        echo "$state is too deep for the host's socket; use a worktree with a shorter path" >&2
        exit 1
    fi
    mkdir -p "$root/.dev/bin" "$state"
    chmod 700 "$state"
    target="${CARGO_TARGET_DIR:-target}/build"
    LATCH_BUILD_STATE_DIR="$state" LATCH_BUILD_API_URL="$api" CARGO_TARGET_DIR="$target" cargo build --release --locked
    cp "$target/release/latch" "$root/.dev/bin/.latch.new"
    mv -f "$root/.dev/bin/.latch.new" "$root/.dev/bin/latch"
    "$root/.dev/bin/latch" --version
