# The Linux test container `just test --linux` runs in (scripts/test.py):
# the pinned Rust, bubblewrap for latch's sandbox, Python for the installer
# tests, cargo-nextest as CI pins it, and the libraries the pinned Chrome
# for Testing and Camoufox need headless. browser-engines.sh installs the
# engines themselves into .dev/linux-cft-state at test time.
FROM rust:1.99.0
RUN rustup component add clippy rustfmt \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bubblewrap python3 unzip xvfb nodejs npm \
      libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libxkbcommon0 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2t64 \
      libpango-1.0-0 libcairo2 fonts-liberation libgtk-3-0t64 libx11-xcb1 libdbus-1-3 \
 && rm -rf /var/lib/apt/lists/* \
 && curl -sSfL https://get.nexte.st/0.9.148/linux-arm | tar xzf - -C /usr/local/cargo/bin
