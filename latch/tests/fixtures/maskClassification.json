    {
      "name": "card with two custom fields of the same name",
      "why": "a token has to name one field: two custom fields called `number` would both qualify to custom:number, so neither is offered and neither can be released — refused rather than resolved by whichever came first",
      "bitwarden": {
        "id": "A1",
        "name": "Ambiguous",
        "type": 3,
        "card": {
          "number": "4111111111111111"
        },
        "fields": [
