    {
      "name": "card with a hidden custom field of the same name",
      "why": "the collision resolves per entry: the built-in stays visible under its own name while the custom one is masked under custom:cardholder name",
      "bitwarden": {
        "id": "C2",
        "name": "Amex",
        "type": 3,
        "card": {
          "cardholderName": "Jon Doe"
