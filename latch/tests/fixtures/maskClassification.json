    {
      "name": "linked field pointing at an empty slot",
      "why": "a link names a fixed slot by number. This login has no username slot and a Hidden custom field that happens to be called `username`; the link must resolve to the slot or to nothing at all, never fall through to the custom field, which would release a concealed value classified from the absent slot as visible",
      "bitwarden": {
        "id": "L9",
        "name": "Fallthrough",
        "type": 1,
        "login": {
          "password": "pw",
          "uris": [
            {
              "uri": "https://x.example/"
            }
          ]
        },
        "fields": [
          {
            "name": "username",
            "type": 1,
            "value": "concealed-custom"
          },
          {
            "name": "who",
            "type": 3,
            "value": null,
            "linkedId": 100
          }
        ]
      },
      "expect": [
        {
          "label": "password",
          "hidden": true,
          "custom": false,
          "alias": false
