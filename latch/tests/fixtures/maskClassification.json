    {
      "name": "secure note with every custom field type",
      "why": "a Hidden custom field is masked and a Text or Boolean one is not, which is what the client shows; a Linked field carries a reference rather than a value and is not reported — the one field kind still unsupported",
      "bitwarden": {
        "id": "N1",
        "name": "Notes",
        "type": 2,
        "fields": [
          {
            "name": "plain",
            "type": 0,
            "value": "visible text"
          },
          {
            "name": "concealed",
            "type": 1,
            "value": "masked text"
          },
          {
            "name": "agreed",
            "type": 2,
            "value": "true"
          },
          {
            "name": "points at username",
            "type": 3,
            "value": null,
            "linkedId": 100
          }
        ],
        "notes": "a note body"
      },
      "expect": [
        {
          "label": "plain",
          "hidden": false,
          "custom": true,
          "alias": false
        },
        {
          "label": "concealed",
          "hidden": true,
          "custom": true,
          "alias": false
        },
        {
          "label": "agreed",
          "hidden": false,
          "custom": true,
          "alias": false
        },
        {
          "label": "notes",
          "hidden": false,
          "custom": false,
          "alias": false
        }
      ]
    },
